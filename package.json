{
  "name": "bookcook",
  "private": true,
  "version": "1.2.0",
  "description": "Recipes in their own words: say or type a recipe, cook it hands-free.",
  "license": "MIT",
  "homepage": "https://rvyyv-n.github.io/bookcook/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rvyyv-n/bookcook.git"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "site:dev": "vite website --port 5290",
    "site:build": "vite build website",
    "site:deploy": "vite build website && cd website && npx wrangler pages deploy dist --project-name=getbookcook --branch=main",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "vitest run && eslint . --cache --cache-location node_modules/.cache/eslint && prettier --check . --cache --log-level warn --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "parse:score": "tsx scripts/parse-score.ts",
    "icons": "node scripts/icons.mjs",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "tauri": "tauri",
    "android:sync": "tsc -b && vite build --mode native && cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2",
    "@capgo/capacitor-printer": "^8.1.4",
    "@capgo/capacitor-speech-recognition": "^8.3.2",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@tauri-apps/plugin-opener": "^2.6.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.48.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
