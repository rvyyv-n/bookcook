{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bookcook",
  "version": "../package.json",
  "identifier": "io.github.rvyyvn.bookcook",
  "build": {
    "beforeBuildCommand": "npm run build:desktop",
    "beforeDevCommand": "npm run dev -- --port 5288",
    "devUrl": "http://localhost:5288",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bookcook",
        "width": 1280,
        "height": 800,
        "minWidth": 390,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
