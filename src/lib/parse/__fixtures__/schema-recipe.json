      "@type": ["Recipe"],
      "name": "Classic Banana Bread",
      "author": [{ "@type": "Person", "name": "Jane Baker" }],
      "description": "Moist and easy banana bread &amp; a family favourite.",
      "image": [{ "@type": "ImageObject", "url": "https://example.com/banana.jpg" }],
      "recipeYield": ["8", "1 loaf (8 slices)"],
      "prepTime": "PT15M",
